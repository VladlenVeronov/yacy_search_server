<!-- YACY public header: logo (left) + menu trigger + Login (right) -->
<header class="w-full border-b border-gray-200 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-14">
    <a href="index.html" class="flex items-baseline gap-1 text-gray-900 hover:text-blue-600 transition">
      <span class="text-lg font-light tracking-tight">VIR</span>
      <span class="text-lg font-semibold tracking-tight text-blue-600">GOO</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <a href="Register.html" class="hidden sm:inline-flex items-center px-3 py-1.5 text-sm font-medium text-gray-700 hover:text-blue-600 transition">
        Реєстрація
      </a>
      <a href="User.html" class="hidden sm:inline-flex items-center px-3 py-1.5 text-sm font-medium text-gray-700 hover:text-blue-600 transition">
        Увійти
      </a>
      <button type="button" id="yacy-menu-toggle"
              aria-label="Open services menu" aria-expanded="false" aria-controls="yacy-drawer"
              class="inline-flex items-center justify-center w-10 h-10 rounded-md text-gray-700 hover:bg-gray-100 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
          <path d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Right-side services drawer (bottomsheet on mobile, drawer on desktop) -->
<div id="yacy-drawer-backdrop" class="yacy-drawer-backdrop fixed inset-0 bg-black/40 z-40"></div>
<aside id="yacy-drawer"
       class="yacy-drawer fixed top-0 right-0 h-full w-80 max-w-[90vw] bg-white shadow-xl z-50 overflow-y-auto"
       aria-hidden="true">
  <div class="flex items-center justify-between px-4 h-14 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">Services</h2>
    <button type="button" id="yacy-drawer-close" aria-label="Close menu"
            class="w-9 h-9 rounded-md text-gray-700 hover:bg-gray-100 transition inline-flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
        <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
      </svg>
    </button>
  </div>

  <div id="yacy-services-grid" class="p-4 grid grid-cols-3 gap-3"></div>

  <p id="yacy-services-empty" class="px-4 pb-4 text-xs text-gray-500 hidden">
    No services configured.
  </p>
</aside>

<script>
  (function () {
    var toggle = document.getElementById('yacy-menu-toggle');
    var close = document.getElementById('yacy-drawer-close');
    var drawer = document.getElementById('yacy-drawer');
    var backdrop = document.getElementById('yacy-drawer-backdrop');

    function setOpen(open) {
      drawer.classList.toggle('open', open);
      backdrop.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    }
    toggle.addEventListener('click', function () { setOpen(!drawer.classList.contains('open')); loadServices(); });
    close.addEventListener('click', function () { setOpen(false); });
    backdrop.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

    var loaded = false;
    function loadServices() {
      if (loaded) return;
      loaded = true;
      var grid = document.getElementById('yacy-services-grid');
      var empty = document.getElementById('yacy-services-empty');
      fetch('/api/vector/services').then(function (r) {
        if (!r.ok) throw new Error('http ' + r.status);
        return r.json();
      }).then(function (items) {
        if (!Array.isArray(items) || items.length === 0) {
          empty.classList.remove('hidden');
          return;
        }
        var esc = function (s) { return String(s).replace(/[<>&"]/g, function (c) { return ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'})[c]; }); };
        grid.innerHTML = items.map(function (s) {
          var icon = s.icon_url
            ? '<img src="' + esc(s.icon_url) + '" alt="" class="w-8 h-8 object-contain" loading="lazy" />'
            : '<span class="text-gray-400 text-lg">' + esc((s.name || '?').slice(0, 1).toUpperCase()) + '</span>';
          return '<a href="' + esc(s.url) + '" target="_blank" rel="noopener" class="flex flex-col items-center gap-2 p-3 rounded-lg hover:bg-gray-100 transition text-center">' +
                 '<span class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center">' + icon + '</span>' +
                 '<span class="text-xs text-gray-700 line-clamp-1">' + esc(s.name) + '</span>' +
                 '</a>';
        }).join('');
      }).catch(function () {
        loaded = false; // allow retry
        empty.classList.remove('hidden');
      });
    }
  })();
</script>
