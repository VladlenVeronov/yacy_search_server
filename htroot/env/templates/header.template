<script type="text/javascript">
  document.documentElement.classList.add('yg-html');
  document.addEventListener('DOMContentLoaded', function () {
    document.body.classList.add('yg-admin');

    var burger = document.getElementById('ygBurger');
    var side = document.getElementById('ygSide');
    var bd = document.getElementById('ygBackdrop');
    function toggle() { side.classList.toggle('is-open'); bd.classList.toggle('is-open'); }
    if (burger) burger.addEventListener('click', toggle);
    if (bd) bd.addEventListener('click', toggle);

    // Active link highlight
    try {
      var here = location.pathname.replace(/^.*\//, '').split('?')[0];
      document.querySelectorAll('.yg-nav__items a').forEach(function (a) {
        var hr = (a.getAttribute('href') || '').split('?')[0];
        if (here && hr === here) a.classList.add('is-active');
      });
    } catch (_) {}

    // Accordion sections — only one open at a time. Persist the open
    // section in localStorage; on first load, expand the section that
    // contains the active link, falling back to the saved one.
    var sections = Array.prototype.slice.call(
      document.querySelectorAll('.yg-nav__section[data-collapsible="true"]')
    );
    var OPEN_KEY = 'yg.nav.open';
    var savedOpen = localStorage.getItem(OPEN_KEY) || '';
    var activeSec = (function () {
      var a = document.querySelector('.yg-nav__items a.is-active');
      return a ? a.closest('.yg-nav__section[data-collapsible="true"]') : null;
    })();
    var initialOpen = activeSec
      || sections.find(function (s) { return s.dataset.key === savedOpen; })
      || sections[0]
      || null;
    sections.forEach(function (sec) {
      sec.dataset.collapsed = (sec === initialOpen) ? 'false' : 'true';
    });
    sections.forEach(function (sec) {
      var ttl = sec.querySelector('.yg-nav__section-title');
      if (!ttl) return;
      ttl.addEventListener('click', function () {
        var openNow = sec.dataset.collapsed === 'false';
        sections.forEach(function (s) { s.dataset.collapsed = 'true'; });
        if (!openNow) {
          sec.dataset.collapsed = 'false';
          localStorage.setItem(OPEN_KEY, sec.dataset.key || '');
        } else {
          localStorage.setItem(OPEN_KEY, '');
        }
      });
    });
  });

  function sendSteeringRequest(tokenInputId, formId) {
    var xhr = new XMLHttpRequest();
    xhr.onreadystatechange = function() {
      if (xhr.readyState == XMLHttpRequest.DONE) {
        if (xhr.status != 200) {
          alert(xhr.status == 401
            ? "Please authenticate with administrator credentials."
            : "The server rejected the request or is not responding!");
        } else {
          var t = document.getElementById(tokenInputId);
          if (t) {
            t.value = xhr.getResponseHeader("X-YaCy-Transaction-Token");
            var f = document.getElementById(formId);
            if (f) { f.submit(); return; }
          }
          alert("Could not send the request to the server!");
        }
      }
    };
    xhr.open("get", "Steering.html", true);
    xhr.send();
  }
  function confirmRestart() { if (confirm('Перезапустити вузол?')) sendSteeringRequest("restartTransactionToken", "restartForm"); }
  function confirmShutdown() { if (confirm('Зупинити вузол?')) sendSteeringRequest("shutdownTransactionToken", "shutdownForm"); }
</script>

