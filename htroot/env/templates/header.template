<script type="text/javascript">
  // mark body as admin-shell-styled (used by env/yacy-admin.css)
  document.documentElement.classList.add('yg-html');
  document.addEventListener('DOMContentLoaded', function () {
    document.body.classList.add('yg-admin');
    var burger = document.getElementById('ygBurger');
    var side = document.getElementById('ygSide');
    var bd = document.getElementById('ygBackdrop');
    function toggle() { side.classList.toggle('is-open'); bd.classList.toggle('is-open'); }
    if (burger) burger.addEventListener('click', toggle);
    if (bd) bd.addEventListener('click', toggle);

    // Highlight current sidebar entry
    try {
      var here = location.pathname.replace(/^.*\//, '');
      document.querySelectorAll('.yg-sidebar__list a').forEach(function (a) {
        var href = a.getAttribute('href') || '';
        if (here && href.indexOf(here.split('?')[0]) === 0) a.classList.add('is-active');
      });
    } catch (_) {}
  });

  /**
   * Request the server for a valid transaction token and then send a steering request.
   * @param tokenInputId HTML identifier of the transaction token input field
   * @param formId identifier of the form
   */
  function sendSteeringRequest(tokenInputId, formId) {
    var xhr = new XMLHttpRequest();
    xhr.onreadystatechange = function() {
      if (xhr.readyState == XMLHttpRequest.DONE) {
        if (xhr.status != 200) {
          if (xhr.status == 401) {
            alert("Please authenticate with administrator credentials.");
          } else {
            alert("The server rejected the request or is not responding!");
          }
        } else {
          var sent = false;
          var t = document.getElementById(tokenInputId);
          if (t) {
            t.value = xhr.getResponseHeader("X-YaCy-Transaction-Token");
            var f = document.getElementById(formId);
            if (f) { sent = true; f.submit(); }
          }
          if (!sent) alert("Could not send the request to the server!");
        }
      }
    };
    xhr.open("get", "Steering.html", true);
    xhr.send();
  }
  function confirmRestart() { if (confirm('Confirm Re-Start')) sendSteeringRequest("restartTransactionToken", "restartForm"); }
  function confirmShutdown() { if (confirm('Confirm Shutdown')) sendSteeringRequest("shutdownTransactionToken", "shutdownForm"); }
</script>

