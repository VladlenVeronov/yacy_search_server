# Production deployment env. Copy to deploy/.env on the server and fill in.
# NEVER commit deploy/.env — it is gitignored.

# Public hostname your YaCy will be reachable at. Traefik routes
# https://${YACY_HOST}/ → yacy:8090 and /api/vector/* → vector_service.
YACY_HOST=search.example.com

# Postgres (vector store) credentials. Generate with `openssl rand -hex 16`.
POSTGRES_DB=yacy_pages
POSTGRES_USER=yacy
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-16

# Admin token for the services_menu CRUD API and admin-services.html.
# Generate with `openssl rand -hex 24`. Anyone with this token can
# add/edit/remove items in the public services drawer.
ADMIN_TOKEN=replace-me-with-openssl-rand-hex-24

# Optional: LLM gap-analyzer (zero-click queries -> seed crawl URLs).
# Leave empty to keep the feature off; cron-unsat-seed.sh exits cleanly.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# YaCy admin digest-auth used by cron-unsat-seed.sh to post crawl URLs
# into the YaCy crawl queue. Leave empty if the cron is not active.
YACY_ADMIN_USER=
YACY_ADMIN_PASS=
